# Copy to .env (never committed) and fill in your own values.
DB_URL=jdbc:mysql://localhost:3306/societal_portal
DB_USERNAME=portal_app
DB_PASSWORD=
# At least 32 random characters
JWT_SECRET=
# true only for a local demo: creates accounts with a publicly known password
DEMO_DATA=false
# Creates the first admin when none exists (password: 12+ characters). Remove afterwards.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# false only for plain-HTTP local development
COOKIE_SECURE=false
